# Copy this file to .env.production on the VPS and replace every value.
DOMAIN=telegraph.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=telegraph
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=telegraph
DATABASE_URL=postgresql://telegraph:replace-with-a-long-random-password@postgres:5432/telegraph

MINIO_ROOT_USER=telegraph
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=telegraph
S3_SECRET_KEY=replace-with-a-long-random-password
S3_BUCKET=article-images
